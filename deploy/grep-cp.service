[Unit]
Description=grep-cp - read-only MCP log search server
Documentation=https://modelcontextprotocol.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grep-cp
Group=grep-cp
ExecStart=/usr/local/bin/grep-cp serve --config /etc/grep-cp/config.toml
# SIGHUP reloads the TLS certificate without a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Environment=GREP_CP_LOG=info
Environment=GREP_CP_LOG_FORMAT=json

# Be polite to a shared production box.
Nice=10
# best-effort/7 (lowest) rather than idle: idle can starve completely while rsyslog writes nonstop.
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=200%
# Reclaim pressure before the hard limit kills the process.
MemoryHigh=768M
MemoryMax=1G
TasksMax=64

# Hardening. The process only ever reads the log root and /etc/grep-cp.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
# install.sh rewrites this line when --log-root differs.
ReadOnlyPaths=/var/log/remote
ReadOnlyPaths=/etc/grep-cp
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Optional: allow only your client ranges at the socket level (in addition to the firewall).
#IPAddressDeny=any
#IPAddressAllow=10.0.0.0/8 127.0.0.1
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
